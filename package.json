{
  "name": "tally",
  "version": "1.0.0",
  "private": true,
  "description": "Privacy-friendly visitor statistics for our sites: a tracker script, a collector, and a copy to BigQuery.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/migrate.js && node src/index.js",
    "dev": "node --env-file-if-exists=.env src/migrate.js && node --env-file-if-exists=.env --watch src/index.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "add-site": "node --env-file-if-exists=.env scripts/add-site.js",
    "test": "node --test",
    "deploy": "./deploy.sh",
    "import-umami": "node --env-file-if-exists=.env scripts/import-umami.js"
  },
  "dependencies": {
    "@ip-location-db/dbip-country-mmdb": "^2.3.2026060120",
    "detect-browser": "^5.3.0",
    "express": "^5.1.0",
    "isbot": "^5.2.2",
    "mmdb-lib": "^3.0.3",
    "mysql2": "^3.14.1"
  }
}
